RABBITMQ_URL=amqp://guest:guest@vinculo-vial-rabbitmq:5672/
RABBITMQ_EXCHANGE=vvi.topic.exchange
RABBITMQ_DLQ_EXCHANGE=vvi.dlq.exchange
INPUT_QUEUE=ia.alert-evidence-uploaded.q
MAX_RETRIES=5
WORKERS=2
PUBLISH_CONFIRM_TIMEOUT_MS=5000
S3_REGION=us-east-1
EVIDENCE_BUCKET=vinculo-vial-evidence-dev-<sufijo>
# Credenciales: cadena por defecto de boto3. En local, solo en .env (nunca commiteadas); rol IAM en producción:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Tope por parte de evidencia (ciphertext); más grande se trata como EVIDENCE_UNREADABLE sin descargar
EVIDENCE_MAX_PART_BYTES=1048576
S3_TIMEOUT_MS=5000
S3_BREAKER_FAILURE_THRESHOLD=5
S3_BREAKER_WINDOW_MS=60000
S3_BREAKER_OPEN_DURATION_MS=30000
S3_BREAKER_HALF_OPEN_MAX_CALLS=1
# Clave privada HPKE (X25519, 32 bytes en base64). Pareja de IA_HPKE_PUBLIC_KEY (Vehicle y app).
# La de desarrollo la genera Vehicle; nunca se commitea.
IA_HPKE_PRIVATE_KEY=reemplazar
ENV=local
# true en todo entorno real. false solo con ENV=local: sube la evidencia sin redactar (no hay modelos en US-08)
REDACTION_REQUIRED=true
# Umbrales del dominio. Los de cada modelo los va a definir su adaptador cuando exista
REID_T_LOW=0.50
REID_T_HIGH=0.70
# OCR_MIN_CONF=0.78 es PROVISORIO: sale del dataset de Roboflow (tools/eval/ocr.py) y hay que revisarlo con fotos propias
OCR_MIN_CONF=0.78
# DAMAGE_MIN_CONF=0.70 es PROVISORIO: sale de CarDD test y 416 autos enteros de Open Images (tools/eval/damage_fp.py); revisar con fotos propias de detalle sin daño
DAMAGE_MIN_CONF=0.70
FACE_MIN_CONF=0.30
PLATE_REDACT_MIN_CONF=0.20
# Rampa: solape auto/rebaje en escalas de rueda. < T_LOW el auto no bloquea (RED: CONTEXT_NOT_DETECTED);
# entre T_LOW y T_HIGH es dudoso (YELLOW: CONTEXT_UNCERTAIN); desde T_HIGH bloquea. SIN CALIBRAR con fotos propias
RAMP_T_LOW=-0.08
RAMP_T_HIGH=0.08
RAMP_SCALE_FALLBACK=0.45
REDACT_MAX_SIDE_PX=1600
# Confianza mínima de un auto para el segmentador (MODEL_SEGMENTER)
SEGMENTER_MIN_CONF=0.50
# Confianza mínima de autos y ruedas para el detector (MODEL_DETECTOR). Las patentes y los rostros
# salen desde el menor entre FACE_MIN_CONF y PLATE_REDACT_MIN_CONF: ante la duda, se tapa
DETECTOR_MIN_CONF=0.40
# Presencia de auto en TODAS las fotos: el auto (o una parte, en PLATE y DETAIL) ocupa al menos esta fracción
# de la foto. Con 0,05 ningún caso de Open Images sin auto pasó (0 de 489; cota 95 % = 0,6 %)
PRESENCE_MIN_AREA=0.05
# Mosaico para rostros y patentes chicos: la foto grande se recorre también en tiles (más lento; ver
# tools/eval/README.md). PROVISORIO: sale de WIDER FACE y de Open Images; validar con fotos propias.
# Rostros: sin mejora medida en fotos parecidas a las del servicio y cuesta 5 veces la latencia.
# Patentes: +7 puntos de recall a cambio de ~1,1 s más por foto
FACE_TILING=false
PLATE_TILING=true
TILING_TILE_PX=640
TILING_OVERLAP=0.25
# Confianza mínima de las instancias de cordón y rebaje del modelo de rebajes (MODEL_CURB)
CURB_MIN_CONF=0.50
# Modelos por puerto: "null" (default) o el nombre de un modelo de models/manifest.json.
# Al arrancar se verifica el sha256 de cada modelo seleccionado; si falta o no coincide, no arranca.
# Redacción (PROVISORIO hasta validar con fotos propias; ver tools/eval/README.md):
# MODEL_DETECTOR: autos, ruedas y patentes. rfdetr_openimages se entrena con tools/training/detector
# MODEL_FACE: rostros. scrfd_10g es el det_10g.onnx de InsightFace (pesos para investigación: el uso comercial
# requiere su licencia); rfdetr_openimages también sirve, pero encuentra peor las caras chicas
MODEL_DETECTOR=rfdetr_openimages
MODEL_FACE=scrfd_10g
# Disponible: rfdetr_seg_coco (se exporta con tools/export/rfdetr_seg.py)
MODEL_SEGMENTER=null
# Disponible: rfdetr_seg_curb (se entrena con tools/training/curb; hace falta tu dataset de rebajes)
MODEL_CURB=null
# Disponible: dinov2_vits14 (se exporta con tools/export/dinov2.py)
MODEL_EMBEDDER=null
# Disponible: parseq (se exporta con tools/export/parseq.py). Una sola línea de texto: motos fuera de alcance
MODEL_OCR=null
# Disponible: rfdetr_cardd (se entrena con tools/training/damage; CarDD no se redistribuye)
MODEL_DAMAGE=null
# Carpeta del host con los pesos (nunca en git). Compose la monta de solo lectura en /models.
# Obligatoria si algún MODEL_* no es null.
MODELS_DIR=./models/weights
MODELS_MANIFEST=models/manifest.json
# Hilos por inferencia de ONNX Runtime (0 = automático). Con WORKERS > 1 conviene acotarlo.
ONNX_INTRA_OP_THREADS=0
HEALTH_PORT=8080
# Solo para los scripts de tools/ (no las lee el servicio). Siempre fuera del repo: tienen patentes y caras de terceros.
# EVAL_DATA_DIR es la raíz; cada evaluación tiene su subcarpeta (ocr-roboflow, ocr, curb...)
# EVAL_DATA_DIR=D:\vv-eval
# EVAL_OUT=D:\vv-eval\out
