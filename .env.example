RABBITMQ_URL=amqp://guest:guest@vinculo-vial-rabbitmq:5672/
RABBITMQ_EXCHANGE=vvi.topic.exchange
RABBITMQ_DLQ_EXCHANGE=vvi.dlq.exchange
INPUT_QUEUE=ia.alert-evidence-uploaded.q
MAX_RETRIES=5
# Alertas a la vez: tamaño del pool de inferencia y prefetch del consumer. Multiplica con REDACT_WORKERS:
# ver "Producción: hilos por alerta y concurrencia del consumer" en tools/eval/README.md
WORKERS=2
PUBLISH_CONFIRM_TIMEOUT_MS=5000
S3_REGION=us-east-1
EVIDENCE_BUCKET=vinculo-vial-evidence-dev-<sufijo>
# Credenciales: cadena por defecto de boto3. En local, solo en .env (nunca commiteadas); rol IAM en producción:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Tope por parte de evidencia (ciphertext); más grande se trata como EVIDENCE_UNREADABLE sin descargar
EVIDENCE_MAX_PART_BYTES=1048576
S3_TIMEOUT_MS=5000
S3_BREAKER_FAILURE_THRESHOLD=5
S3_BREAKER_WINDOW_MS=60000
S3_BREAKER_OPEN_DURATION_MS=30000
S3_BREAKER_HALF_OPEN_MAX_CALLS=1
# Clave privada HPKE (X25519, 32 bytes en base64). Pareja de IA_HPKE_PUBLIC_KEY (Vehicle y app).
# La de desarrollo la genera Vehicle; nunca se commitea.
IA_HPKE_PRIVATE_KEY=reemplazar
ENV=local
# true en todo entorno real. false solo con ENV=local: sube la evidencia sin redactar (no hay modelos en US-08)
REDACTION_REQUIRED=true
# Veredicto de la IA: solo GREEN o RED. RED con evidencia firme (R1 a R4); todo lo dudoso es GREEN.
# R2, re-ID: SOLO la foto GENERAL contra la de PLATE (la trompa o la cola, cortada entre el capot y el parabrisas); DETAIL y
# CONTEXT no se comparan. Se compara el recorte de la caja del vehículo dominante del detector, sin máscaras (el segmentador
# decide la presencia, R1). BURST_MISMATCH solo si el coseno es menor que REID_T; si es dudoso o no se puede comparar, GREEN.
# 0,2565 (15/11/2026): el mayor umbral con la cota de U1 <= 1 % en validación con los pares general-patente de 3DRealCar
# (dinov2_vits14_reid_v2; tools/eval/reid_parciales.py). En prueba: U1 3 de 778 (0,39 %, cota 0,99 %), S4 98,0 % y 90,5 % en
# pares difíciles. Opción conservadora: 0,0638 (el menor con S4 >= 70 %): U1 0 de 778 (cota 0,39 %), S4 69,6 %, difíciles 46,2 %.
# Los pares de patente son simulados y salen de una misma sesión de captura (U1 optimista); validar con fotos propias. Con
# otro embedder hay que recalibrar
REID_T=0.2565
# R3: PLATE_MISMATCH solo con una lectura segura (OCR_MIN_CONF) que no coincide; casi igual o ilegible, GREEN.
# Una lectura sin el largo ni la estructura de ABC123 o AB123CD también es ilegible (nunca una patente distinta).
# 0,78 es PROVISORIO: sale del dataset de Roboflow (tools/eval/ocr.py) y hay que revisarlo con fotos propias
OCR_MIN_CONF=0.78
# Confianza mínima del adaptador de daño (MODEL_DAMAGE, experimental, fuera de la cascada). El daño ya no cuenta
# como presencia en ninguna foto: DETAIL sigue la misma regla que GENERAL (R1). El nombre es histórico
DAMAGE_PRESENCE_T=0.97
# 0,10 (16/11/2026; antes 0,20): con mosaico, recall de patentes de terceros 91,1 % (con 0,20, 87,4 %) en las 204
# fotos de prueba de Open Images, a cambio de ~0,7 cajas tapadas de más por foto; ver tools/eval/README.md
PLATE_REDACT_MIN_CONF=0.10
REDACT_MAX_SIDE_PX=1600
# Fotos que se planifican a la vez al redactar (patentes y OCR). Cada alerta usa hasta este
# número de hilos: con varios WORKERS en la misma CPU conviene bajarlo
REDACT_WORKERS=3
# Lado mayor (px) al que se reduce cada foto antes de los modelos; las cajas vuelven al original.
# Una foto de celular de 4000 x 3000 se infiere a 1024 x 768: es lo que mantiene la cascada bajo 12 s
MODEL_MAX_SIDE_PX=1024
# Confianza mínima de un auto para el segmentador (MODEL_SEGMENTER)
SEGMENTER_MIN_CONF=0.50
# Confianza mínima de autos y ruedas para el detector (MODEL_DETECTOR). Las patentes salen desde
# PLATE_REDACT_MIN_CONF: ante la duda, se tapa. El producto no redacta rostros (riesgo aceptado).
# 0,35 con v2 y el segmentador en 0,50 (decisión del 14/11/2026; antes 0,40): S1 válido con tolerancia, ver
# tools/eval/README.md (R1 con el encuadre de 1-2 m)
DETECTOR_MIN_CONF=0.35
# R1, presencia de vehículo en TODAS las fotos (GENERAL, PLATE, DETAIL y CONTEXT, la misma regla): el vehículo
# (caja `car` del detector o instancia del segmentador) ocupa al menos esta fracción de la foto. Ni la patente ni
# la rueda ni el daño cuentan como presencia
PRESENCE_MIN_AREA=0.05
# Mosaico para patentes chicas: la foto grande se recorre también en tiles (más lento; ver tools/eval/README.md).
# PROVISORIO: sale de Open Images; validar con fotos propias. Solo se usa al redactar (la presencia usa un único
# pase sin mosaico). Patentes: +7 puntos de recall
PLATE_TILING=true
TILING_TILE_PX=640
TILING_OVERLAP=0.25
# Confianza mínima de las instancias de cordón y rebaje del modelo de rebajes (MODEL_CURB)
CURB_MIN_CONF=0.50
# Modelos por puerto: "null" (default) o el nombre de un modelo de models/manifest.json.
# Al arrancar se verifica el sha256 de cada modelo seleccionado; si falta o no coincide, no arranca.
# Redacción (PROVISORIO hasta validar con fotos propias; ver tools/eval/README.md):
# MODEL_DETECTOR: vehículos y patentes. rfdetr_openimages_v2 es el detector por defecto (decisión del 14/11/2026;
# tools/training/detector_v2): cuentan como vehículo `car` (con taxi), `van` y `truck`; el colectivo no cuenta, y la
# ambulancia se entrenó como `van`. No tiene rostros ni ruedas. rfdetr_openimages (v1, tools/training/detector)
# queda en el manifest como respaldo: se vuelve a él cambiando esta variable
# MODEL_FACE: EXPERIMENTAL y fuera de la cascada, como MODEL_DAMAGE y MODEL_CURB. El producto solo tapa patentes de
# terceros: los rostros no se redactan (riesgo aceptado: las fotos se toman a 1-2 m centradas en el vehículo) y nadie
# llama a este puerto. El código queda para retomarlo (scrfd_10g: pesos de InsightFace, que piden licencia comercial)
MODEL_DETECTOR=rfdetr_openimages_v2
MODEL_FACE=null
# En la cascada (decisión del 12/11/2026): la presencia (R1) la decide det ∨ seg (la caja `car` del detector o una
# instancia del segmentador) y la re-ID (R2) compara el auto segmentado. Con null los autos salen de las cajas `car` del
# detector. Disponible: rfdetr_seg_coco (se exporta con tools/export/rfdetr_seg.py)
MODEL_SEGMENTER=rfdetr_seg_coco
# EXPERIMENTAL y EN CONSTRUCCIÓN, fuera de la cascada: vacío = no se cargan pesos. El chequeo de rebajes se sacó del
# veredicto; el código queda para retomarlo (rfdetr_seg_curb, tools/training/curb)
MODEL_CURB=
# dinov2_vits14_reid_v2 (activado el 15/11/2026): DINOv2 ViT-S/14 ajustado con los 2.009 autos de 3DRealCar
# (tools/training/reid; los pesos van fuera de git). Disponibles también dinov2_vits14 (sin ajustar, se exporta con
# tools/export/dinov2.py) y dinov2_vits14_reid (la primera versión). Cambiar de modelo obliga a recalibrar REID_T
MODEL_EMBEDDER=dinov2_vits14_reid_v2
# parseq (activado el 16/11/2026; se exporta con tools/export/parseq.py). Sin OCR, R3 no compara y la patente
# reportada no se exceptúa al redactar (se tapa). Pesos: baudm/parseq-small de Hugging Face (Apache-2.0, declarada por el
# autor en la ficha del modelo), byte a byte los de la release v1.0.0 (SHA-256 bb5792a6...cd00; ver THIRD_PARTY.md).
# Una sola línea de texto: motos fuera de alcance
MODEL_OCR=parseq
# Disponible: rfdetr_cardd (se entrena con tools/training/damage; CarDD no se redistribuye)
MODEL_DAMAGE=null
# Carpeta del host con los pesos (nunca en git). Compose la monta de solo lectura en /models.
# Obligatoria si algún MODEL_* no es null.
MODELS_DIR=./models/weights
MODELS_MANIFEST=models/manifest.json
# Hilos por inferencia de ONNX Runtime (0 = automático). Con WORKERS > 1 conviene acotarlo.
ONNX_INTRA_OP_THREADS=0
HEALTH_PORT=8080
# Solo para los scripts de tools/ (no las lee el servicio). Siempre fuera del repo: tienen patentes y caras de terceros.
# EVAL_DATA_DIR es la raíz; cada evaluación tiene su subcarpeta (ocr-roboflow, ocr, curb...)
# EVAL_DATA_DIR=D:\vv-eval
# EVAL_OUT=D:\vv-eval\out
